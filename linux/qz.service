[Unit]
Description=qdomyos-zwift service
After=multi-user.target

[Service]
Type=idle  
Restart=always
RestartSec=30
WorkingDirectory=/tmp
ExecStart=/home/foo/qdomyos-zwift/src/qdomyos-zwift -qml -no-gui -heart-service
ExecStop=killall -9 qdomyos-zwift
User=root  

[Install]  
WantedBy=multi-user.target 
